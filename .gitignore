# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# One-time fantasy research cache; only normalized evidence snapshots are committed.
tmp/fantasy-context/
tmp/pdfs/

# Transient fantasy certification worker state. Current merged/sharded v5
# evidence is committed separately; discovery reports remain local history.
/lib/fantasy/data/certificationBackground.generated.log
/lib/fantasy/data/certificationBackground.pid.json
/lib/fantasy/data/certificationBackground.status.generated.json
/lib/fantasy/data/systematicDraftAudit.ablation-*.generated.json
/lib/fantasy/data/systematicDraftAudit.close-*.generated.json
/lib/fantasy/data/systematicDraftAudit.dispute-*.generated.json
/lib/fantasy/data/systematicDraftAudit.escalation-*.generated.json
/lib/fantasy/data/systematicDraftAudit.postfix-*.generated.json
/lib/fantasy/data/systematicDraftAudit.regression-middle-*.generated.json
/lib/fantasy/data/systematicDraftAudit.regression-prod-*.generated.json
/lib/fantasy/data/systematicDraftAudit.regression-v[234]-*.generated.json
