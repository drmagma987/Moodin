NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FANTASYPROS_API_KEY=
# Disabled by default; the configured key must have working news/injury quota.
FANTASYPROS_NEWS_ENABLED=false
THE_ODDS_API_KEY=
# Optional comma-separated override. Default costs up to 8 credits per NFL event returned.
THE_ODDS_API_MARKETS=
THE_ODDS_API_MAX_EVENTS=16
FANTASY_PLAYER_CONTEXT_JSON=
# Optional QB/rookie metric records. Unvalidated lanes never alter ranks or projections.
FANTASY_ADVANCED_RESEARCH_JSON=
# off | shadow | production. Production still fails closed unless the generated
# rookie-WR walk-forward report clears every activation threshold.
FANTASY_ROOKIE_WR_MODEL_MODE=shadow
# Optional JSON array of credential-free HTTPS RSS/Atom or JSON news feeds.
# Fields: id, label, url, format (rss|json), sourceKind
# (official-injury|team-report|beat-writer|fantasy-news), trust
# (primary|verified|aggregator|unknown).
FANTASY_NEWS_FEEDS_JSON=
