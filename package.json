    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
