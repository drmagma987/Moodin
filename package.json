{
  "name": "moodin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fantasy:integrity": "node ./lib/fantasy/validateLeagueIntegrity.mjs",
    "fantasy:test": "node --test --no-warnings --experimental-strip-types --loader ./tests/ts-alias-loader.mjs ./tests/fantasy-model.test.ts",
    "fantasy:snapshot": "node --no-warnings --experimental-strip-types --loader ./tests/ts-alias-loader.mjs --env-file=.env.local ./scripts/build_fantasy_board_snapshot.mjs",
    "fantasy:pressure-test": "node --no-warnings --experimental-strip-types --loader ./tests/ts-alias-loader.mjs ./scripts/run_fantasy_draft_pressure_test.mjs",
    "fantasy:counterfactual-audit": "node --no-warnings --experimental-strip-types --loader ./tests/ts-alias-loader.mjs ./scripts/run_fantasy_counterfactual_audit.mjs",
    "fantasy:systematic-audit": "node --no-warnings --experimental-strip-types --loader ./tests/ts-alias-loader.mjs ./scripts/run_fantasy_systematic_audit.mjs",
    "fantasy:systematic-audit-merge": "node ./scripts/merge_fantasy_systematic_audit.mjs",
    "fantasy:certification:start": "node ./scripts/run_fantasy_certification_background.mjs start",
